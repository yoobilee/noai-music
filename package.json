{
  "name": "noai-music",
  "description": "A local-first browser extension for filtering officially labeled AI or altered music content on YouTube and YouTube Music.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "wxt": "^0.21.4"
  },
  "scripts": {
    "dev": "wxt --browser chrome --mv3",
    "build": "wxt build --browser chrome --mv3",
    "zip": "wxt zip --browser chrome --mv3",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:all": "npm run verify && playwright test",
    "postinstall": "wxt prepare"
  }
}
